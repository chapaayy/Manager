# XPPN Manager: on first setup edit only three values.
XPPN_DOMAIN=manager.example.com
XPPN_ADMIN_USER=admin
XPPN_ADMIN_PASSWORD=

# Optional notifications:
XPPN_ALERT_BOT_TOKEN=
XPPN_ALERT_CHAT_ID=

# Automatically generated by install.sh; preserve on upgrades:
# XPPN_SESSION_SECRET=
# XPPN_DATA_KEY=
