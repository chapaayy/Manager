# Set the publicly reachable hostname and ensure 80/443 and DNS point here.
XPPN_DOMAIN=manager.example.com
XPPN_PUBLIC_URL=https://manager.example.com
XPPN_ALLOWED_HOSTS=manager.example.com,localhost,127.0.0.1
XPPN_SECURE_COOKIES=true
# Generate by setup.sh; NEVER use these placeholders in production.
XPPN_SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX
XPPN_DATA_KEY=REPLACE_WITH_FERNET_KEY
# Default denies private/internal SSH destinations to prevent SSRF.
XPPN_ALLOW_PRIVATE_SSH=false

# Optional 2-minute offline/disk alert notifications (keep secrets out of GitHub).
XPPN_ALERT_BOT_TOKEN=
XPPN_ALERT_CHAT_ID=
# Enable only after deploy/install-updater.sh is configured on the host.
XPPN_UPDATE_ENABLED=false
