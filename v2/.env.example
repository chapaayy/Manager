# XPPN Manager production environment example.
# install.sh normally creates this file as v2/.env with mode 0600.
XPPN_V2_DB=/data/xppn-v2.db
XPPN_V2_DOMAIN=manager.example.com
XPPN_V2_ADMIN_USER=admin
XPPN_V2_ADMIN_PASSWORD_HASH=REPLACE_WITH_SETUP_ENV_GENERATED_HASH
XPPN_V2_SESSION_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_32_CHARACTER_SECRET
XPPN_DATA_KEY=REPLACE_WITH_FERNET_32_BYTE_BASE64_KEY
XPPN_V2_COOKIE_SECURE=1
