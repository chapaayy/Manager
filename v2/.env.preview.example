# Standalone preview on loopback port 8790, NOT production.
# Set values yourself and chmod 600. Do not reuse a known weak password.
XPPN_V2_DB=/data/xppn-v2.db
XPPN_V2_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
XPPN_V2_SESSION_SECRET=REPLACE_WITH_A_RANDOM_AT_LEAST_32_CHARACTER_SECRET
XPPN_DATA_KEY=REPLACE_WITH_FERNET_32_BYTE_BASE64_KEY
# Loopback-only HTTP testing; set 1 when serving through HTTPS.
XPPN_V2_COOKIE_SECURE=0
